# ─────────────────────────────────────────────────────────────
# Thai Flood Causal-Chain GraphRAG — environment
# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Neo4j ──────────────────────────────────────────────────────
# พอร์ต host เลือกให้ไม่ชนกับ Neo4j อื่นในเครื่องนี้
#   (7474/7475 และ 7687/7688 ถูกจองไปแล้วโดย container อื่น)
NEO4J_HTTP_PORT=7476
NEO4J_BOLT_PORT=7689
NEO4J_USER=neo4j
NEO4J_PASSWORD=floodgraph123
# URI ที่โค้ด Python ใช้เชื่อมต่อ
#   - รันจากเครื่อง host        → bolt://localhost:7689
#   - รันในคอนเทนเนอร์ app      → bolt://neo4j:7687  (docker-compose ตั้ง NEO4J_URI ให้เอง)
NEO4J_URI=bolt://localhost:7689

# ── Streamlit UI ──────────────────────────────────────────────
STREAMLIT_PORT=8501

# ── LLM / Embeddings ──────────────────────────────────────────
# generation ใช้ Claude
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-opus-4-8
# GISTDA (optional; ห้าม commit ค่าจริง — .env ถูก gitignore แล้ว)
#   Map key (basemap ใน UI) ขอที่ https://sphere.gistda.or.th
GISTDA_API_KEY=
#   Data key (flood API real-time) ขอที่ disaster.gistda.or.th → api-gateway (ดู manual_api.pdf)
GISTDA_DATA_KEY=
GISTDA_GATEWAY_BASE=https://api-gateway.gistda.or.th/api/2.0
# embedding model แยก (ใช้กับ vector-rag / entity-graphrag)
#   ตัวเลือก: openai | huggingface | local
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-m3
OPENAI_API_KEY=

# ── Data source endpoints (ยืนยันจริงตอนเฟส 1 แล้วอัปเดต README) ──
DATAGOTH_CKAN_BASE=https://data.go.th/api/3/action
THAIWATER_API_BASE=https://api.thaiwater.net/v1
GISTDA_STAC_BASE=https://disaster.gistda.or.th/api/stac

# ── Geo ───────────────────────────────────────────────────────
# CRS เดียวทั้งโปรเจกต์ (UTM 47N สำหรับไทย) — ดู skill geo-basin-to-province
PROJECT_CRS=EPSG:32647

# ── Paths ─────────────────────────────────────────────────────
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
